# USB за TWRP на sofiar (замества init.recovery.usb.rc от sm6125-common).
#
# Версията в common tree-то има СОБСТВЕНО правило за
# "sys.usb.config=adb && sys.usb.ffs.ready=1", което пише UDC "none" и после
# пак закача контролера. TWRP init.rc има същото правило. Двете се
# задействат едно след друго: UDC се откача, adbd пада, ffs.ready 0 -> 1 и
# всичко започва отначало, безкрайно (видяно в диагностиката на всеки ~100ms).
# Тук оставяме само Moto настройките на gadget-а; закачането за "adb" го
# прави единствено TWRP init.rc. За "mtp,adb" TWRP init.rc няма правило,
# затова то е тук (само едно, без "UDC none" -> няма цикъл).

on init
    mkdir /config
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/bcdUSB 0x0200
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/ffs.fastboot
    # MTP през kernel драйвера f_mtp (/dev/mtp_usb) - TWRP го ползва сам,
    # когато няма /dev/usb-ffs/mtp
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    # MS OS descriptors -> Windows сам закача WinUSB драйвер за adb
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    setprop sys.usb.configfs 1
    # (не е USB) подробен лог от twrp-common/prepdecrypt в recovery.log
    setprop prepdecrypt.loglevel 2

# (не е USB) Декриптиране: пускаме qseecomd -> keymaster -> gatekeeper още при
# старта, вместо да чакаме TWRP да зададе ro.crypto.state. Иначе TWRP опитва
# DE ключовете (след 1 сек. пауза) преди keymaster да е готов и се отказва.
on property:hwservicemanager.ready=true
    setprop crypto.ready 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral

# --- MTP + adb (TWRP превключва на "mtp,adb" при старт) ---
# TWRP init.rc за "none" откача UDC, спира adbd и маха f1; тук махаме и f2.
on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    write /config/usb_gadget/g1/idProduct 0x4EE2
    symlink /config/usb_gadget/g1/functions/mtp.gs0 /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}
