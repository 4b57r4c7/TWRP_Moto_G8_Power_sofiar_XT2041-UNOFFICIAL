# Android fstab (fs_mgr формат) за recovery на sofiar.
# Чете се от init и от vold/fscrypt при декриптиране - затова ТРЯБВА да е в
# стандартния Android формат (иначе: "Error parsing fs_mgr_options" и
# fscrypt_initialize_systemwide_keys пада).
# TWRP-специфичният fstab е recovery/root/system/etc/twrp.fstab.
# Стойности за /data - от stock (fileencryption=ice:aes-256-cts, fscrypt v1).
#
#<src>                                   <mnt_point> <type> <mnt_flags and options>                                                        <fs_mgr_flags>
/dev/block/bootdevice/by-name/metadata   /metadata   ext4   noatime,nosuid,nodev,discard                                                   wait,formattable
/dev/block/bootdevice/by-name/userdata   /data       f2fs   noatime,nosuid,nodev,discard,nobarrier,reserve_root=32768,resgid=1065,inlinecrypt  latemount,wait,check,formattable,fileencryption=ice:aes-256-cts,quota,reservedsize=128M,checkpoint=fs
/dev/block/bootdevice/by-name/misc       /misc       emmc   defaults                                                                       defaults
